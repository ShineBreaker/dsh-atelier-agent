{
  "name": "dsh-atelier-agent",
  "version": "0.4.0",
  "description": "pi atelier 的 dsh 移植：外部 agent CLI 分屏编排（peer 工具派发 pi/hermes/claude/codex 等持久会话，文件契约回收，resume 无损恢复），与原生 subagent 互补共存",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShineBreaker/dsh-atelier-agent.git"
  },
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "commands.js",
    "client.js",
    "hooks.js",
    "lib/",
    "tools/",
    "core/",
    "runtime/",
    "context/",
    "cordis.patch.yml",
    "test/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh": "^0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=23.6"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "test": "node test/smoke.js",
    "test:live": "HERDR_ENV=1 node test/e2e-drive.mjs",
    "test:tui": "bash test/tui-smoke.sh"
  }
}
